<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 flex items-center justify-center p-4">
  <div class="max-w-3xl w-full">
    <%= if @current_user do %>
      <div class="text-center">
        <h1>Enneagram Test</h1>
        <p class="mt-4 text-lg text-gray-600">Logged in as: <%= @current_user %></p>
        <button phx-click="start_test" class="mt-8 bg-blue-500 hover:bg-blue-600 text-white px-8 py-4 rounded-lg text-xl font-semibold">
          Start Test
        </button>
      </div>
    <% else %>
      <div class="text-center">
        <h2 class="text-3xl font-bold mb-8">Welcome to Enneagram Test</h2>
        <p class="text-gray-600 mb-8">Please select a user to begin</p>
        <div class="flex justify-center space-x-8">
          <button phx-click="select_user" phx-value-user="ACE" class="bg-blue-500 hover:bg-blue-600 text-white px-8 py-4 rounded-lg text-xl font-semibold">
            ACE
          </button>
          <button phx-click="select_user" phx-value-user="ELI" class="bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-lg text-xl font-semibold">
            ELI
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>